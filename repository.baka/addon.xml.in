<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.baka"
       name="Baka Repository"
      version="1.0.8"
       provider-name="baka">
  <extension point="xbmc.addon.repository" name="Baka Repository">
    <dir>
      <info compressed="false">@PAGES_URL@/catalog/addons.xml</info>
      <checksum>@PAGES_URL@/catalog/addons.xml.md5</checksum>
      <datadir zip="true">@PAGES_URL@/zips/</datadir>
      <hashes>false</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="de_DE">Baka Repository</summary>
    <summary lang="en_GB">Baka Repository</summary>
    <description lang="de_DE">Bezugsquelle für Baka für Kodi.</description>
    <description lang="en_GB">Distribution source for Baka for Kodi.</description>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <website>https://gitlab.com/gerxstream/gerxstream</website>
    <source>https://gitlab.com/gerxstream/gerxstream</source>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
